#!/usr/bin/env bash

# Strip broken magic-nix-cache settings from every nix.conf:
#   post-build-hook       -- v14's auto-upload uses a broken upstream
#                            filter that re-uploads cache.nixos.org
#                            paths. cache-deps.yml uploads by hand.
#   build-provenance-tags -- unknown to upstream Nix (installed with
#                            determinate:false), warns every invocation.

set -o errexit
set -o errtrace
set -o nounset
set -o pipefail

# GNU sed (-i no arg, ERE via -E) and BSD sed (-i requires an
# extension, BRE only) disagree; -i.bak with two -e clauses works on
# both.
strip() {
  sed -i.bak -e '/^post-build-hook/d' -e '/^build-provenance-tags/d' "$1"
  rm -f "$1.bak"
}
export -f strip

for f in \
  "$HOME/.config/nix/nix.conf" \
  "${XDG_CONFIG_HOME:-$HOME/.config}/nix/nix.conf" \
  /etc/nix/nix.conf \
  /etc/nix/nix.custom.conf; do
  [ -f "$f" ] || continue
  if [ -w "$f" ]; then
    strip "$f"
  else
    sudo bash -c "$(declare -f strip); strip '$f'"
  fi
done

if nix config show 2>/dev/null | grep -qE '^post-build-hook = .'; then
  echo "post-build-hook still set after strip:" >&2
  nix config show | grep -i post-build-hook >&2
  exit 1
fi
