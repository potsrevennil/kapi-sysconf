#!/usr/bin/env bash

# Fail if a command's output contains a deprecation notice or an error,
# even when the command itself exits 0. Passes the output through unchanged.
#
# Usage:  <cmd> 2>&1 | scripts/check-output
#
# Add to `patterns` (e.g. `warning:`) to catch more.

set -o errexit
set -o nounset
set -o pipefail

patterns='deprecated|will be removed|error:'

out="$(mktemp)"
trap 'rm -f "$out"' EXIT

# Print the output live and save a copy to grep once it's complete.
tee "$out"

if grep -E -i -n "$patterns" "$out" >/dev/null; then
  echo "::error::output contains deprecation or error lines:" >&2
  grep -E -i -n "$patterns" "$out" >&2
  exit 1
fi
