#!/usr/bin/env bash

# tput needs $TERM; CI runners run scripts headless so it isn't set.
# Fall back to blank codes rather than erroring on `set -e`.
_tput() { tput "$@" 2>/dev/null || true; }

RED="$(_tput setaf 1)"
GREEN="$(_tput setaf 2)"
YELLOW3="$(_tput setaf 148)"
BLUE="$(_tput setaf 4)"
GREY54="$(_tput setaf 249)"
NORMAL="$(_tput sgr0)"

export RED
export GREEN
export YELLOW3
export BLUE
export GREY54
export NORMAL
# UNDERLINE=$(tput smul)

# export to avoid lsp warning
export DEBUG="${BLUE}DEBUG"
export INFO="${GREEN}INFO"
export WARN="${YELLOW3}WARN"
export ERROR="${RED}ERROR"

log()
{
  local level="${FUNCNAME[1]^^}"
  printf "%s\t%s\t%b\n" "${GREY54}$(date "+%T")" "${!level}" "${*}"
}

debug()
{
  log "${NORMAL}${*}"
}

info()
{
  log "${NORMAL}${*}"
}

warn()
{
  log "${NORMAL}${*}" 1>&2
}

error()
{
  log "${NORMAL}${*}" 1>&2
}
