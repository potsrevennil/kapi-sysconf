_fzf_comprun() {
  local command=$1
  shift

  case "$command" in
    cd)             fzf --preview "tree -C {} | head -200"      "$@";;
    export|unset)   fzf --preview "eval 'echo \$'{}"            "$@";;
    ssh)            fzf --preview "dig {}"                      "$@";;
    *)              fzf --preview 'bat -n --color=always {}'    "$@";;
  esac
}

# Keep `#` literal (nixpkgs#hello, `gco #47`): zsh-utils' completion plugin turns on
# EXTENDED_GLOB globally, which makes `#` a glob operator. Code that needs it (completion,
# p10k, fast-syntax-highlighting) sets it locally, so turning it back off is safe.
unsetopt extended_glob

# alias
alias ls="ls --color"
