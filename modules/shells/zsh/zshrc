zsh_plugins=$HOME/.config/zsh/zsh_plugins
fpath=(${ANTIDOTE}/functions $fpath)
autoload -Uz antidote
if [[ ! ${zsh_plugins}.zsh -nt ${zsh_plugins}.txt ]]; then
  (
    source ${ANTIDOTE}/antidote.zsh
    antidote bundle <${zsh_plugins}.txt >${zsh_plugins}.zsh
  )
fi
source ${zsh_plugins}.zsh

# powerlevel10k prompt cache
if [[ -r "${XDG_CACHE_HOME}/p10k-instant-prompt-''${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME}/p10k-instant-prompt-''${(%):-%n}.zsh"
fi

# powerlevel10k prompt
source $HOME/.p10k.zsh

# set brew for macOS
if [[ "$(uname)" == "Darwin" ]]; then
  if [[ "$(uname -m)" == "arm64" ]]; then
    BREW="/opt/homebrew/bin/brew"
  else
    BREW="/usr/local/bin/brew"
  fi

  if [[ -x "$BREW" ]]; then
    eval "$($BREW shellenv)"
  fi
fi

# direnv
eval "$(direnv hook zsh)"

# fzf
eval "$(fzf --zsh)"

_fzf_comprun() {
  local command=$1
  shift

  case "$command" in
    cd)             fzf --preview "tree -C {} | head -200"      "$@";;
    export|unset)   fzf --preview "eval 'echo \$'{}"            "$@";;
    ssh)            fzf --preview "dig {}"                      "$@";;
    *)              fzf --preview 'bat -n --color=always {}'    "$@";;
  esac
}

# fix catch command not found when executing nix command with "#"
# setopt noglob

# alias
alias ls="ls --color"
alias fman="compgen -c | fzf | xargs man"

# Worktree-aware git (zsh only: git has no hook for new `worktree` subcommands or for
# changing `checkout`/`switch`, and a git alias cannot cd the shell).
#   git worktree path <branch>   print the worktree that has <branch> checked out
#   git checkout|switch <branch> cd into that worktree instead of failing with
#                                "already used by worktree"; also covers omz gco/gsw
# Sets REPLY to the worktree of branch $1; one `git worktree list`, parsed in-shell.
_git_worktree_of() {
  local line wt
  for line in ${(f)"$(command git worktree list --porcelain 2>/dev/null)"}; do
    case $line in
      'worktree '*) wt=${line#worktree } ;;
      "branch refs/heads/$1") REPLY=$wt; return 0 ;;
    esac
  done
  return 1
}

git() {
  local REPLY
  case "$1:$2" in
    worktree:path)
      (( $# == 3 )) || { print -u2 'usage: git worktree path <branch>'; return 129 }
      _git_worktree_of $3 && print -r -- $REPLY
      return ;;
    checkout:[^-]*|switch:[^-]*)
      # Only a bare `git checkout <branch>`; flags, paths and `-` go straight to git.
      if (( $# == 2 )) && _git_worktree_of $2 && [[ -d $REPLY ]] &&
         [[ $(command git symbolic-ref -q --short HEAD) != $2 ]]; then
        print -u2 "Switched to worktree '$REPLY'"
        cd $REPLY
        return
      fi ;;
  esac
  command git "$@"
}
