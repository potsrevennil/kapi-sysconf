# Git config for AI agent sessions: output trimmed for token cost, layered over the normal
# config. Claude Code includes it from ~/.claude/settings.json:
#
#   "env": {"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "include.path",
#           "GIT_CONFIG_VALUE_0": "~/.config/git/agent.gitconfig"}
#
# An include, not GIT_CONFIG_GLOBAL: the normal global config still loads, a missing file
# (an older branch checked out) is skipped instead of dropping identity, and
# `git config --global` writes the normal config as usual. Interactive shells never read it.

# Short status with the branch line, instead of the long form with hint paragraphs.
[status]
	short = true
	branch = true

# Hint paragraphs written for people learning git.
[advice]
	statusHints = false
	detachedHead = false
	addEmptyPathspec = false
	commitBeforeMerge = false
	resolveConflict = false
	skippedCherryPicks = false
	pushUpdateRejected = false
	setUpstreamFailure = false
	forceDeleteBranch = false
	defaultBranchName = false

[fetch]
	output = compact

[merge]
	stat = false

# No pager, color or delta overrides: agents' output is never a TTY, so git already skips
# them.
