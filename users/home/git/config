[alias]
	# Print the path of the worktree that has branch $1 checked out (zshrc's `gco` cds there).
	wt = "!f() { git worktree list --porcelain | awk -v b=refs/heads/$1 '/^worktree /{p=substr($0,10)} $2==b{print p; ok=1; exit} END{exit !ok}'; }; f"

[commit]
	template = "/Users/thing-hanlim/.config/git/gitmessage_global"

[core]
	editor = "nvim"
	pager = delta

[delta]
    features = Dracula
	navigate = true
	side-by-side = true

[diff]
	colorMoved = "default"

[interactive]
	diffFilter = "delta --color-only"

[merge]
	conflictstyle = "diff3"

